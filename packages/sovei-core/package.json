{
  "name": "@soveilove/sovei",
  "version": "2.1.0-dev.2",
  "description": "Sovei 工作流引擎 — 便携式开发 SOP、类型化知识管理与演进式架构治理",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soveilove/harness.git",
    "directory": "packages/sovei-core"
  },
  "homepage": "https://github.com/Soveilove/harness#readme",
  "bugs": {
    "url": "https://github.com/Soveilove/harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/release/sovei.js"
  ],
  "bin": {
    "sovei": "dist/release/sovei.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-release.mjs",
    "build:release": "node scripts/build-release.mjs",
    "dev": "tsx src/cli/index.ts",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm run check && pnpm test && pnpm run verify:package"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
