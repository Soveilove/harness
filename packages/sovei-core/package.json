{
  "name": "@soveilove/sovei",
  "version": "2.5.10",
  "description": "⚠️ 高速迭代中：当前版本更新频率较高，建议关注最新版本。Sovei 工作流引擎 — 便携式开发 SOP、类型化知识管理与演进式架构治理。",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soveilove/sovei.git"
  },
  "homepage": "https://github.com/Soveilove/sovei#readme",
  "bugs": {
    "url": "https://github.com/Soveilove/sovei/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "engines": {
    "node": ">=14.18.0"
  },
  "files": [
    "dist/release/sovei.cjs",
    "LICENSE.md"
  ],
  "bin": {
    "sovei": "dist/release/sovei.cjs"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-release.mjs",
    "build:release": "node scripts/build-release.mjs",
    "dev": "tsx src/cli/index.ts",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm run check && pnpm test && pnpm run verify:package"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "commander": "^12.1.0",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.0.3",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  }
}
